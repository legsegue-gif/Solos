            "value": "嗦螺仕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嗦螺仕"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Solos"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Solos 设置闹钟或计时器时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你讓 Solos 設定鬧鐘或計時器時使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos sets alarms and timers when you ask it to."
          }
        }
      }
    },
    "NSAppleMusicUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Solos 搜索或播放资料库里的音乐时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你讓 Solos 搜尋或播放資料庫裡的音樂時使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos searches and plays music in your library when you ask it to."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Solos 查看或添加日历事件时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你讓 Solos 檢視或新增行事曆活動時使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos reads and adds calendar events when you ask it to."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Solos 按姓名查找联系人时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你讓 Solos 依姓名查詢聯絡人時使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos looks up contacts by name when you ask it to."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Solos 读取步数、心率、睡眠、体重等健康数据时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你讓 Solos 讀取步數、心率、睡眠、體重等健康資料時使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos reads health data such as steps, heart rate, sleep and weight when you ask it to."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Solos 记录体重、饮水等健康数据时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你讓 Solos 記錄體重、飲水等健康資料時使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos records health data such as weight or water when you ask it to."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos 连接你配置的模型服务，包括局域网里的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos 連線你設定的模型服務，包括區域網路裡的。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos connects to model endpoints you configure, including ones on your local network."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你问附近的天气、地点或路线时，Solos 用你的位置来回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你問附近的天氣、地點或路線時，Solos 用你的位置來回答。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos uses your location when you ask about weather, places or routes near you."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Solos 保存对话里的图片时，存到你的相册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你讓 Solos 儲存對話裡的圖片時，存到你的相簿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos saves pictures from a chat to your photos when you ask it to."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos 列出你的照片，并把你选中的复制到工作区，供脚本处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos 列出你的照片，並把你選中的複製到工作區，供腳本處理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos lists your photos and copies the ones you choose into its workspace so a script can work on them."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Solos 查看或添加提醒事项时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你讓 Solos 檢視或新增提醒事項時使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solos reads and adds reminders when you ask it to."
          }
        }
      }
    }
  },
  "version": "1.0"
}