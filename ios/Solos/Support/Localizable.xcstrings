    },
    "The model sent nothing for %@ seconds, so the turn was stopped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型 %@ 秒没有任何输出，本轮已停止。"
