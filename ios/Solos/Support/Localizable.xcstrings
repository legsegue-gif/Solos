    "This chat no longer exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话已不存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個對話已不存在。"
          }
        }
      }
    },
    "This chat's endpoint no longer exists. Choose another model.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话使用的接入点已不存在，请换一个模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個對話使用的端點已不存在，請換一個模型。"
          }
        }
      }
    },
    "This conversation has reached the model's limit (about %@ of %@ tokens). Start a new chat to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话已达到模型上限（约 %1$@ / %2$@ token）。请开始新对话继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個對話已達到模型上限（約 %1$@ / %2$@ token）。請開始新對話繼續。"
          }
        }
      }
    },
    "This conversation is close to the model's limit (about %@ of %@ tokens). Summarize the earlier part to continue, or start a new chat.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话已接近模型上限（约 %1$@ / %2$@ token）。摘要前面的部分后继续，或开始新对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個對話已接近模型上限（約 %1$@ / %2$@ token）。摘要前面的部分後繼續，或開始新對話。"
          }
        }
      }
    },
    "This conversation is longer than the model accepts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话已经超过模型能接受的长度。"
