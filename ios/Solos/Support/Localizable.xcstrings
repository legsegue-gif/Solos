          "stringUnit": {
            "state": "translated",
            "value": "資料夾裡的內容不會被刪除。"
          }
        }
      }
    },
    "Files can only be put in the workspace (/solos/ws) or a shared folder that allows changes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件只能放进工作区（/solos/ws）或允许修改的共享文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
