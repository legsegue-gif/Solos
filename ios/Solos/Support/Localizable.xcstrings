    "A link to a repository, or to the folder in one that holds the SKILL.md.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库的链接，或仓库中包含 SKILL.md 的文件夹的链接。"
