          "stringUnit": {
            "state": "translated",
            "value": "這個對話已經超過模型能接受的長度。"
          }
        }
      }
    },
    "This file cannot be read.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不了这个文件。"
          }
