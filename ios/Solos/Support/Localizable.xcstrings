            "state": "translated",
            "value": "停止共享這個資料夾？"
          }
        }
      }
    },
    "Nothing in the folder is deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹里的内容不会被删除。"
          }
        },
