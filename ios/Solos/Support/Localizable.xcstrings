            "value": "你的剪貼簿"
          }
        }
      }
    },
    "your personal data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的个人数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的個人資料"
          }
        }
      }
    },
    "Allow access to %@?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问%@？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許存取%@？"
          }
        }
      }
    },
    "The assistant wants to read %@. What it reads becomes part of the conversation and is sent to the AI service you chose in Settings, not to Solos. This also covers your calendar, reminders, contacts, location, photos and clipboard. You can change this in Settings > Privacy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手想读取%@。它读到的内容会成为对话的一部分，并发送给你在设置里选择的 AI 服务，而不是发给 Solos。这也包括你的日历、提醒事项、通讯录、位置、照片和剪贴板。你可以在“设置 > 隐私”里更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助手想讀取%@。它讀到的內容會成為對話的一部分，並傳送給你在設定裡選擇的 AI 服務，而不是傳給 Solos。這也包括你的日曆、提醒事項、聯絡人、位置、照片和剪貼簿。你可以在「設定 > 隱私權」裡更改。"
          }
        }
      }
    },
    "Personal data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人資料"
          }
        }
      }
    },
    "Health data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "健康資料"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱私權"
          }
        }
      }
    },
    "Whether the assistant may read your calendar, reminders, contacts, location, photos and clipboard, and separately your health data. What it reads is sent to the AI service you chose. Off asks you the first time it is needed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手能否读取你的日历、提醒事项、通讯录、位置、照片和剪贴板，以及单独的健康数据。它读到的内容会发送给你选择的 AI 服务。关闭时，第一次需要时会询问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助手能否讀取你的日曆、提醒事項、聯絡人、位置、照片和剪貼簿，以及單獨的健康資料。它讀到的內容會傳送給你選擇的 AI 服務。關閉時，第一次需要時會詢問你。"
          }
        }
      }
    },
    "%@ The key is kept in the Keychain. Everything you send in a chat (messages, attachments and what the assistant reads on your device) goes to this service; see its privacy policy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 密钥保存在钥匙串里。你在对话里发送的一切（消息、附件，以及助手在你设备上读到的内容）都会发给这个服务，请参阅它的隐私政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 金鑰保存在鑰匙圈裡。你在對話裡傳送的一切（訊息、附件，以及助手在你裝置上讀到的內容）都會傳給這個服務，請參閱它的隱私權政策。"
          }
        }
      }
    },
    "Other data sources": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他数据来源"
          }
        },
        "zh-Hant": {
