    },
    "This conversation has reached the model's limit (about %@ of %@ tokens). Start a new chat to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话已达到模型上限（约 %1$@ / %2$@ token）。请开始新对话继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個對話已達到模型上限（約 %1$@ / %2$@ token）。請開始新對話繼續。"
          }
        }
      }
    },
    "This conversation is close to the model's limit (about %@ of %@ tokens). Summarize the earlier part to continue, or start a new chat.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个对话已接近模型上限（约 %1$@ / %2$@ token）。摘要前面的部分后继续，或开始新对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
