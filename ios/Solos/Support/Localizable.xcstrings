    "Turned off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關閉"
          }
        }
      }
    },
    "Off keeps the endpoint and its key but hides its models from the model menu; chats on it cannot be sent until it is turned on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后保留端点和密钥，但模型菜单里不再列出它的模型；使用它的对话需重新启用后才能发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後保留端點和金鑰，但模型選單裡不再列出它的模型；使用它的對話需重新啟用後才能傳送。"
          }
        }
      }
    },
    "The endpoint %@ is turned off. Turn it on in Settings, or choose another model.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点 %@ 已关闭。请在设置中启用它，或选择其他模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "端點 %@ 已關閉。請在設定中啟用它，或選擇其他模型。"
          }
        }
      }
    },
    "Delete Endpoint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除端点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除端點"
          }
        }
      }
    },
    "This removes the endpoint, its models and its API key. Chats that used it keep their messages and need another model.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除该端点、它的模型和 API 密钥。使用过它的对话会保留消息，但需要改用其他模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除該端點、它的模型和 API 金鑰。使用過它的對話會保留訊息，但需要改用其他模型。"
          }
        }
      }
